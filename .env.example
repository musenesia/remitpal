# DATABASE_URL: PostgreSQL connection string.
# Render injects this automatically from your PostgreSQL database resource.
# For local development, point this at your local PostgreSQL instance.
# e.g. postgresql://user:password@localhost:5432/amanah
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/amanah"

# NODE_ENV: Set to "production" on Render. Use "development" locally.
NODE_ENV="development"

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Gemini model used by the AI agent. Defaults to gemini-3.8-flash
# (gemini-2.5-flash is gated off for new API keys; 3.8-flash is the current flash model).
GEMINI_MODEL="gemini-3.8-flash"

# AGENT_MOCK: Set to "true" to run a rule-based mock agent that simulates the
# chat + approval flow without calling Gemini (useful for offline demos).
AGENT_MOCK="false"

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ---------------------------------------------------------------
# WhatsApp Notifications (Fonnte)
# ---------------------------------------------------------------
# FONNTE_TOKEN: Your Fonnte API token (from https://fonnte.com dashboard).
# Required for WhatsApp notifications to work. When absent, WhatsApp
# broadcasting is silently skipped (the app still works normally).
FONNTE_TOKEN=""

# WA_ENABLED: Set to "false" to disable WhatsApp broadcasts even when a
# token is present. Defaults to enabled when FONNTE_TOKEN is set.
WA_ENABLED="true"

# WA_SITI_PHONE / WA_SLAMET_PHONE: Optional overrides for the recipients'
# phone numbers. If set, these take priority over the numbers stored in
# the database. Use international format (e.g. 628123456789) or local
# Indonesian format (e.g. 08123456789 — the "0" is replaced with "62").
WA_SITI_PHONE=""
WA_SLAMET_PHONE=""

# ---------------------------------------------------------------
# PayPal Payouts (Siti -> Slamet remittance)
# ---------------------------------------------------------------
# Get these from the PayPal Developer Dashboard > My Apps & Credentials
# (https://developer.paypal.com/dashboard/applications/sandbox).
# Create a REST app to get a Client ID + Secret, and create a sandbox
# personal account to act as Slamet (the payout receiver).

# PAYPAL_CLIENT_ID: Client ID of your PayPal REST app.
PAYPAL_CLIENT_ID=""

# PAYPAL_CLIENT_SECRET: Secret of your PayPal REST app.
PAYPAL_CLIENT_SECRET=""

# PAYPAL_ENV: "sandbox" (default) for testing, "live" for real money.
PAYPAL_ENV="sandbox"

# PAYPAL_RECIPIENT_EMAIL: Slamet's PayPal account email (the payout
# receiver). In sandbox this is a sandbox personal account's email.
PAYPAL_RECIPIENT_EMAIL=""

# PAYPAL_SENDER_EMAIL: Optional sender email shown in the batch header.
PAYPAL_SENDER_EMAIL=""

# PAYPAL_MOCK: Set to "true" to simulate successful payouts without real
# credentials. Useful for demoing the UI flow before keys are configured.
# Defaults to disabled (empty / "false").
PAYPAL_MOCK="false"
