# DATABASE_URL: PostgreSQL connection string.
# Render injects this automatically from your PostgreSQL database resource.
# For local development, point this at your local PostgreSQL instance.
# e.g. postgresql://user:password@localhost:5432/amanah
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/amanah"

# NODE_ENV: Set to "production" on Render. Use "development" locally.
NODE_ENV="development"

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Gemini model used by the AI agent. Defaults to gemini-3.8-flash
# (gemini-2.5-flash is gated off for new API keys; 3.8-flash is the current flash model).
GEMINI_MODEL="gemini-3.8-flash"

# ---------------------------------------------------------------
# OpenRouter fallback (nvidia/nemotron-3.5-super-vl:free)
# ---------------------------------------------------------------
# When Gemini is overloaded (503) or times out, the agent automatically
# retries with OpenRouter. Free tier, no account approval needed.
# Get your key at https://openrouter.ai/settings/keys.
OPENROUTER_API_KEY=""

# OpenRouter model to use. Defaults to nvidia/nemotron-3.5-super-vl:free
# (free, multimodal, tool calling, 1M context).
OPENROUTER_MODEL="nvidia/nemotron-3.5-super-vl:free"

# AGENT_MOCK: Set to "true" to run a rule-based mock agent that simulates the
# chat + approval flow without calling Gemini (useful for offline demos).
AGENT_MOCK="false"

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ---------------------------------------------------------------
# WhatsApp Notifications (Fonnte)
# ---------------------------------------------------------------
# FONNTE_TOKEN: Your Fonnte API token (from https://fonnte.com dashboard).
# Required for WhatsApp notifications to work. When absent, WhatsApp
# broadcasting is silently skipped (the app still works normally).
FONNTE_TOKEN=""

# WA_ENABLED: Set to "false" to disable WhatsApp broadcasts even when a
# token is present. Defaults to enabled when FONNTE_TOKEN is set.
WA_ENABLED="true"

# WA_SITI_PHONE / WA_SLAMET_PHONE: Optional overrides for the recipients'
# phone numbers. If set, these take priority over the numbers stored in
# the database. Use international format (e.g. 628123456789) or local
# Indonesian format (e.g. 08123456789 — the "0" is replaced with "62").
WA_SITI_PHONE=""
WA_SLAMET_PHONE=""

# ---------------------------------------------------------------
# PayPal Payouts v1 — SANDBOX ONLY (Siti -> Slamet remittance)
# ---------------------------------------------------------------
# Get these from the PayPal Developer Dashboard > My Apps & Credentials
# (https://developer.paypal.com/dashboard/applications/sandbox).
# Create a REST app to get a Client ID + Secret, and create a sandbox
# personal account to act as Slamet (the payment receiver).
#
# RemitPal is Siti's PERSONAL app, not a multi-user service. The payout
# sender is Siti's own PayPal business account — the account that owns
# the REST app credentials. She funds it herself; the app holds no one
# else's money. A payout is created only after Siti approves a plan
# in-app, and a ledger record is created only when PayPal reports the
# payout item SUCCESS. The sandbox REST app must be associated with a
# Business account that has Payouts approved. Live PayPal is never used:
# if PAYPAL_ENV is set to "live" the server ignores it with a warning
# and still calls the sandbox API. Never present a sandbox transfer as
# a live international remittance.
#
# For a multi-user version, Personal Payments v2 would be the right
# method so each sender pays from their own personal account — but that
# API is limited-release and is NOT enabled on this sandbox app (token
# creation returns 403 NOT_AUTHORIZED), so this submission uses
# Payouts v1, which is approved on the same app.

# PAYPAL_CLIENT_ID: Client ID of your PayPal REST app (sandbox).
PAYPAL_CLIENT_ID=""

# PAYPAL_CLIENT_SECRET: Secret of your PayPal REST app (sandbox).
PAYPAL_CLIENT_SECRET=""

# PAYPAL_ENV: "sandbox" only — live is not supported and is ignored.
PAYPAL_ENV="sandbox"

# PAYPAL_RECIPIENT_EMAIL: Slamet's PayPal account email (the payment
# receiver). In sandbox this is a sandbox personal account's email.
PAYPAL_RECIPIENT_EMAIL=""

# PAYPAL_SENDER_EMAIL: Siti's PayPal business account email (the payout
# sender). The sender is implicit in the OAuth token (whoever owns
# PAYPAL_CLIENT_ID), so this is NOT sent in the API call — it's for
# reference only. The sandbox REST app must be associated with a
# Business account with Payouts approved.
PAYPAL_SENDER_EMAIL=""

# PAYPAL_MOCK: Set to "true" for DEMO MODE — payouts are fake (MOCK-<ts>),
# no PayPal call is made, and records are labelled MOCK. Useful for
# demoing the UI flow before keys are configured. Defaults to disabled
# (empty / "false"). DEMO MODE never moves a real payment.
PAYPAL_MOCK="false"

# ---------------------------------------------------------------
# Demo seed accounts (local demo only)
# ---------------------------------------------------------------
# SEED_SITI_PASSWORD / SEED_SLAMET_PASSWORD: passwords for the seeded
# demo accounts (siti = remitter, slamet = manager). Defaults are
# demo-only and must be overridden via env on any shared deploy.
# NOTE: seeding only runs when the users table is empty, so changing
# these later does NOT change existing passwords.
SEED_SITI_PASSWORD=""
SEED_SLAMET_PASSWORD=""
